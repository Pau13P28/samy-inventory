# Copia este archivo como ".env" y ajusta los valores según tu entorno.

# Cadena de conexión a la base de datos.
# Local (por defecto si no se define): sqlite:///./samy.db
# PostgreSQL en Render/Railway: postgresql://usuario:clave@host:5432/nombre_bd
DATABASE_URL=sqlite:///./samy.db

# Dominios permitidos para CORS, separados por coma.
# En local puedes dejar "*". En producción usa la URL real del frontend,
# por ejemplo: https://samy-inventario.netlify.app
CORS_ORIGINS=*
